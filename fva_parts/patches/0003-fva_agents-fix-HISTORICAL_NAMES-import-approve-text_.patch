+++ b/backend/tests/test_fva_agents_fixes.py
@@ -0,0 +1,36 @@
+"""Regression tests for fva_agents: import, approved OCR fixes, SSML to the engine."""
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+import fva_agents as fa  # noqa: E402
+from engines.edge_engine import _split_ssml  # noqa: E402
+
+
+def test_import_works():
+    assert fa.HISTORICAL_NAMES and fa.APPROVED
+
+
+def test_ocr_fix_badaram_is_approved(tmp_path, monkeypatch):
+    monkeypatch.setattr(fa, "AUDIT", tmp_path / "audit.jsonl")
+    out = fa.CleanerAgent().run("بدرم به مداخلات پایان داد.")
+    assert "پدرم" in out
+
+
+def test_engine_gets_ssml_not_raw_tags(tmp_path, monkeypatch):
+    monkeypatch.setattr(fa, "AUDIT", tmp_path / "audit.jsonl")
+    sent = []
+
+    async def fake(text, out, *a, **k):
+        sent.append((text, k))
+        pathlib.Path(out).write_bytes(b"ID3")
+
+    monkeypatch.setattr(fa, "generate_voice", fake)
+    fa.EngineAgent(out_dir=tmp_path).run(1, "سلام دنیا. <break_medium> فصل اول <break_long>")
+    text, kw = sent[0]
+    assert kw.get("is_ssml") is True
+    segs = _split_ssml(text)
+    assert [v for kind, v in segs if kind == "break"] == [500, 900]
+    assert not any("break" in v for kind, v in segs if kind == "text")
