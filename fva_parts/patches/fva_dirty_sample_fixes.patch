diff --git a/backend/core/text_cleaner.py b/backend/core/text_cleaner.py
index 7f6f15a..d9502b7 100644
--- a/backend/core/text_cleaner.py
+++ b/backend/core/text_cleaner.py
@@ -12,14 +12,52 @@ def normalize_numbers(text):
     return text
 
 
+# کتاب «/» را هم جداکنندهٔ هزارگان (۲/۵۰۰/۰۰۰) و هم ممیز (۲/۵ میلیون) به کار می‌برد.
+# فرید «/» را قابل‌پیش‌بینی نمی‌خواند (ممکن است «دو پنجم» بگوید)، پس صریحش می‌کنیم.
+# تاریخ‌ها (۱۳۵۷/۱۱/۲۲) دست نمی‌خورند.
+_THOUSANDS_SLASH_RE = re.compile(r"(?<![۰-۹/])([۰-۹]{1,3})((?:/[۰-۹]{3})+)(?![۰-۹/])")
+_DECIMAL_SLASH_RE = re.compile(r"(?<![۰-۹/])([۰-۹]+)/([۰-۹]+)(?![۰-۹/])")
+
+
+def normalize_number_separators(text):
+    """۲/۵۰۰/۰۰۰ → ۲۵۰۰۰۰۰ ، ۲/۵ → ۲ ممیز ۵ (فقط ارقام فارسی؛ بعد از normalize_numbers)."""
+    text = _THOUSANDS_SLASH_RE.sub(lambda m: m.group(1) + m.group(2).replace("/", ""), text)
+    return _DECIMAL_SLASH_RE.sub(r"\1 ممیز \2", text)
+
+
 def remove_extra_kasra(text):
     """حذف کسره‌ی اضافه‌ی نمایشی (ِ) که در OCR قدیمی رایج است."""
     return text.replace("\u0650", "")
 
 
+# واژه‌هایی که «و» جزء خودشان است، نه «و»ی عطف (از متن واقعی کتاب):
+# نخست‌وزیر، جلای‌وطن، هم‌وطن، بی‌وقفه، حمله‌ور، پیشه‌وران، بهره‌وری،
+# می‌ورزید، ورزشی، وارد، وی، دیوانه‌وار، ...
+_WAW_STEM_RE = re.compile(
+    r"و(?:زیر|طن|قف|فا|زن|زد|رز|ارد|ار(?![\u0600-\u06FF])|ند(?![\u0600-\u06FF])"
+    r"|ری(?![\u0600-\u06FF])|ر(?![\u0600-\u06FF])|ران(?![\u0600-\u06FF])"
+    r"|ی(?![\u0600-\u06FF])|یژ)"
+)
+_WAW_KEEP_LEFT = {"می", "نمی", "بی", "هم"}
+_WAW_SPACE_LEFT = {"به", "با", "از", "در", "که", "بر", "تا"}
+_ATTACHED_WAW_RE = re.compile(r"([\u0600-\u06FF]+)\u200c(و)(\u200c?)([\u0600-\u06FF]*)")
+
+
 def fix_attached_waw(text):
-    """اصلاح «و»ی عطف چسبیده با نیم‌فاصله."""
-    return re.sub(r"\u200cو\u200c?", " و ", text)
+    """اصلاح «و»ی عطف چسبیده با نیم‌فاصله (وابسته‌وهمدل → وابسته و همدل).
+
+    واژه‌های مرکبی که «و» جزء خودشان است دست نمی‌خورند (نخست‌وزیر، بهره‌وری)،
+    و «به‌وی» → «به وی» می‌شود نه «به و ی».
+    """
+    def repl(m):
+        left, waw, zw, rest = m.groups()
+        word = waw + rest
+        if not zw and (left in _WAW_KEEP_LEFT or _WAW_STEM_RE.match(word)):
+            if left in _WAW_SPACE_LEFT:
+                return left + " " + word
+            return m.group(0)
+        return left + " و " + rest if rest else left + " و"
+    return _ATTACHED_WAW_RE.sub(repl, text)
 
 
 _HAMZA_FIXES = (
@@ -171,6 +209,7 @@ def clean_text(text, convert_years: bool = False):
         text = convert_years_to_words(text)
 
     text = normalize_numbers(text)
+    text = normalize_number_separators(text)
     text = remove_extra_kasra(text)
     text = fix_attached_waw(text)
     text = fix_hamza_words(text)
