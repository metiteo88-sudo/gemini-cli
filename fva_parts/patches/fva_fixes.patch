 =?UTF-8?q?=D8=A8=D8=AF=D8=B1=D9=85=E2=86=92=D8=A8=D8=AF=20=D8=B1=D9=85,?=
 =?UTF-8?q?=20=D9=85=D8=A7=D8=A2=D9=85=D8=AF=D9=87=E2=86=92=D9=85=D8=A7=20?=
