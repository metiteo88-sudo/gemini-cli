+"""Tests for .skills/ocr-audit/ocr_audit.py on tiny data with known answers."""
+import importlib.util
+import pathlib
+
+import pytest
+
+TOOL = pathlib.Path(__file__).resolve().parents[2] / ".skills/ocr-audit/ocr_audit.py"
+spec = importlib.util.spec_from_file_location("ocr_audit", TOOL)
+oa = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(oa)
+
+
+def test_categories():
+    st = oa.Stats()
+    hyp = "درسال ۱۳۲۰ ایسران کشا ورزی میشود و ابران"
+    ref = "در سال 1320 ایران کشاورزی می\u200cشود و ایران"
+    oa.score_page(st, 1, hyp, ref)
+    assert st.cat["glued"] == 1           # درسال -> در سال
+    assert st.cat["split"] == 1           # کشا ورزی -> کشاورزی
+    assert st.cat["zwnj"] == 1            # میشود -> می‌شود
+    assert st.cat["char_insert_delete"] == 1   # ایسران -> ایران
+    assert st.cat["char_substitution"] == 1    # ابران -> ایران
+    assert ("س", "") in st.conf
+    assert "1320" not in str(st.ex)       # digits folded: not an error
+
+
+def _write(tmp, name, pages):
+    p = tmp / name
+    p.write_text("\n".join(f"[[page {i}]]\n{t}" for i, t in pages.items()), encoding="utf-8")
+    return str(p)
+
+
+def test_rules_verdicts(tmp_path, monkeypatch):
+    hyp = _write(tmp_path, "hyp.txt", {1: "درسال گذشته آشها رفتند", 2: "درسال نو"})
+    ref = _write(tmp_path, "ref.txt", {1: "در سال گذشته آشها رفتند", 2: "در سال نو"})
+    mod = tmp_path / "rules_mod.py"
+    mod.write_text("T = [('درسال', 'در سال'), ('آشها', 'آنها'), ('گذشته', 'گ ذشته'), ('xyz', 'q')]\n",
+                   encoding="utf-8")
+    out = tmp_path / "r.txt"
+    oa.main(["--root", str(tmp_path), "--out", str(out), "rules", hyp, ref, "--table", "rules_mod:T"])
+    rows = {line.split("'")[1]: line.split()[0] for line in out.read_text(encoding="utf-8").splitlines()
+            if line.startswith("   ") and "'" in line}
+    assert rows["درسال"].startswith("good")
+    assert rows["آشها"] == "REF-KEEPS-SRC"    # reference is unclean: human decides
+    assert rows["گذشته"] == "REF-KEEPS-SRC"   # breaking a correct word that ref has
+    assert rows["xyz"] == "unused"
+
+
+def test_harmful_rule(tmp_path):
+    # rule splits a word that is correct in ref -> more errors, and ref never has the src token
+    hyp = _write(tmp_path, "hyp.txt", {1: "کتابها رسید"})
+    ref = _write(tmp_path, "ref.txt", {1: "کتابهای رسید"})
+    mod = tmp_path / "m2.py"
+    mod.write_text("T = [('کتابها', 'کتاب ها')]\n", encoding="utf-8")
+    out = tmp_path / "r.txt"
+    oa.main(["--root", str(tmp_path), "--out", str(out), "rules", hyp, ref, "--table", "m2:T", "--mode", "token"])
+    assert "HARMFUL" in out.read_text(encoding="utf-8")
+
+
+def test_unclean_ref_is_not_judged(tmp_path):
+    # the old «رزندم -> رزNedم» bug: ref contains the source, the tool must defer to a human
+    hyp = _write(tmp_path, "hyp.txt", {1: "فرزندم آمد"})
+    ref = _write(tmp_path, "ref.txt", {1: "فرزندم آمد"})
+    mod = tmp_path / "m3.py"
+    mod.write_text("T = [('رزندم', 'رزNedم')]\n", encoding="utf-8")
+    out = tmp_path / "r.txt"
+    oa.main(["--root", str(tmp_path), "--out", str(out), "rules", hyp, ref, "--table", "m3:T"])
+    assert "REF-KEEPS-SRC" in out.read_text(encoding="utf-8")
+
+
+def test_never_overwrites_input(tmp_path):
+    hyp = _write(tmp_path, "hyp.txt", {1: "الف"})
+    with pytest.raises(SystemExit):
+        oa.main(["--out", hyp, "quality", hyp, hyp])
+    assert "الف" in pathlib.Path(hyp).read_text(encoding="utf-8")
+
+
+def test_map_finds_prod_and_broken_paths(tmp_path):
+    (tmp_path / "processors").mkdir()
+    (tmp_path / "processors/__init__.py").write_text("")
+    (tmp_path / "processors/ocr_x.py").write_text("import pytesseract\n")
+    (tmp_path / "main.py").write_text("from processors import ocr_x\n")
+    (tmp_path / "old.py").write_text("P = 'tests/golden/raw.txt'\nimport subprocess  # tesseract\n"
+                                     "if __name__ == '__main__':\n    pass\n")
+    out = tmp_path / "map.txt"
+    oa.main(["--root", str(tmp_path), "--out", str(out), "map", "--entry", "main"])
+    rep = out.read_text(encoding="utf-8")
+    assert "[PROD] processors/ocr_x.py" in rep
+    assert "[SCRIPT+BROKEN] old.py" in rep and "tests/golden/raw.txt" in rep
