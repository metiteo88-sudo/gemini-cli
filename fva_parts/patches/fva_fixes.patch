@@ -0,0 +1,56 @@
+"""تست رگرسیون برای باگ‌های تأییدشدهٔ text_cleaner (2026-10-18).
+هر مورد از متن واقعی book_final.txt یا golden/FINAL/main_content_tts.txt آمده است."""
+
+import pytest
+
+from core.text_cleaner import clean_text
+
+
+@pytest.mark.parametrize("src, expected", [
+    # «رزندم» ← «رزNedم» قبلاً وسط «فرزندم» اعمال می‌شد
+    ('سود "فرزندم ,هرگز', 'سود "فرزندم ,هرگز'),
+    # «بدرم» ← «پدرم» (قبلاً «بد رم»)
+    ("بدرم در سال ۱۹۱۵ آمد", "پدرم در سال ۱۹۱۵ آمد"),
+    # حرف «ه» دیگر حذف نمی‌شود
+    ("به استقبال ماآمده بودند", "به استقبال ما آمده بودند"),
+])
+def test_ocr_word_fixes(src, expected):
+    assert clean_text(src) == expected
+
+
+@pytest.mark.parametrize("word", ["درآمد", "درآمدی", "درآمدهای", "درآورد", "درآوردند", "درآید", "درآیند"])
+def test_daramadan_family_is_not_split(word):
+    assert clean_text(f"او {word} ما") == f"او {word} ما"
+
+
+@pytest.mark.parametrize("src, expected", [
+    ("درآنجا ماند", "در آنجا ماند"),
+    ("درآغاز کار", "در آغاز کار"),
+    ("درآینده", "در آینده"),
+    ("نامه\u200cبرروی میز", "نامه\u200cبر روی میز"),
+])
+def test_dar_split_still_works(src, expected):
+    assert clean_text(src) == expected
+
+
+def test_ocr_split_daramad_is_joined():
+    assert clean_text("به تصرف کشورگشایان خارجی درآ مد. اما") == "به تصرف کشورگشایان خارجی درآمد. اما"
+
+
+@pytest.mark.parametrize("text", ["بر روی صفحه ضبط شده", "در چهل صفحه تهیه کرد", "صفحه تلویزیون"])
+def test_real_word_safhe_is_kept(text):
+    assert clean_text(text) == text
+
+
+def test_page_marker_line_is_removed():
+    assert clean_text("متن اول\nصفحه ۱۲\nمتن دوم") == "متن اول\n\nمتن دوم"
+
+
+@pytest.mark.parametrize("src, expected", [
+    ("وظیفهءخطیر", "وظیفه خطیر"),
+    ("جبههءملی", "جبهه ملی"),
+    ("خانهء ما", "خانه ما"),
+    ("دوهفتهء» آمد", "دوهفته» آمد"),
+])
+def test_glued_ezafe_hamza_gets_space(src, expected):
+    assert clean_text(src) == expected
