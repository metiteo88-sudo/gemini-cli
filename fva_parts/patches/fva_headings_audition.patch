@@ -77,10 +77,30 @@ def is_heading(item):
     return t in HEADING_TYPES or "head" in t or "title" in t
 
 
+# سرفصل («فصل دوم») و عنوان («بهره‌وری») جدا خوانده می‌شوند: موتور Edge هر تکهٔ بین
+# دو مکث را جداگانه می‌سازد، پس هر کدام لحن خودش را می‌گیرد.
+# از تگ استاندارد SSML استفاده می‌شود (نه <break_long>) چون همهٔ مسیرها آن را می‌فهمند:
+# build_ssml، edge_engine (tts_txt بدون build_ssml) و strip_ssml برای Piper.
+HEADING_LABEL_PAUSE_MS = 400   # بین سرفصل و عنوان (کوتاه‌تر)
+HEADING_END_PAUSE_MS = 900     # بعد از کل تیتر، قبل از متن
+_HEADING_LABEL_RE = re.compile(
+    r"^((?:فصل|بخش|قسمت|دفتر|باب|گفتار|جلد)\s+[^\s:：\-–—،.]+(?:\s+و\s+[^\s:：\-–—،.]+)?)"
+    r"\s*(?:[:：\-–—.،]\s*(.*))?$"
+)
+
+
+def _brk(ms):
+    return f'<break time="{ms}ms"/>'
+
+
 def spoken_heading(text):
-    """تیتر را جملهٔ مستقل می‌کند تا بعدش مکث بیاید."""
-    text = text.strip()
-    return text if text[-1:] in ".!?؟:…؛" else text + "."
+    """تیتر ← «سرفصل [مکث کوتاه] عنوان [مکث بلند]»؛ تیتر بدون سرفصل ← «تیتر [مکث بلند]»."""
+    text = text.strip().rstrip(".!؟?:؛،")
+    m = _HEADING_LABEL_RE.match(text)
+    if m and m.group(2) and m.group(2).strip():
+        title = m.group(2).strip().rstrip(".!؟?:؛،")
+        return f"{m.group(1)} {_brk(HEADING_LABEL_PAUSE_MS)} {title} {_brk(HEADING_END_PAUSE_MS)}"
+    return f"{text} {_brk(HEADING_END_PAUSE_MS)}"
 
 
 def split_chapters(items):
